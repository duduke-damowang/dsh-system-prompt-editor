{
  "name": "dsh-system-prompt-editor",
  "version": "1.0.0",
  "description": "Manage multiple system prompts in the DSH Settings page and switch the active one; the active prompt is injected as a systemPrompt section into every model assembly.",
  "type": "module",
  "main": "./lib/host/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "scripts/build.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "prompt-manager",
    "settings"
  ],
  "license": "MIT",
  "author": "duduke use ds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duduke-damowang/dsh-system-prompt-editor.git"
  },
  "homepage": "https://github.com/duduke-damowang/dsh-system-prompt-editor#readme",
  "bugs": {
    "url": "https://github.com/duduke-damowang/dsh-system-prompt-editor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.0-rc.2"
}
